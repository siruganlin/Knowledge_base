# 复制为 .env 后填写自己的配置，不要提交真实凭据。

# LLM 与图像识别（OpenAI 兼容接口）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_llm_api_key
LLM_DEFAULT_MODEL=qwen-plus
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=qwen-vl-plus
ITEM_MODEL=qwen-plus

# BGE-M3：改为本机模型目录；CPU 使用 fp32。
BGE_M3_PATH=/path/to/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0

# Milvus 2.4.x
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# MinIO：endpoint 不包含协议；填写自行创建的访问凭据。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=images

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb_history

# 重排序和百炼联网 MCP 共用的 DashScope API Key。
OPENAI_API_KEY=your_dashscope_api_key
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT=Given a web search query, retrieve relevant passages that answer the query.
MCP_DASHSCOPE_BASE_URL=https://your-mcp-endpoint.example/mcp

# MinerU 在线解析
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your_mineru_api_token

# 本地上传和解析文件目录，相对于启动时的工作目录。
DATA_BASED_ROOT_DIR=./data
